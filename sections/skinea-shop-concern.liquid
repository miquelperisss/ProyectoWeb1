{% liquid
  assign concern_blocks = section.blocks | where: 'type', 'concern'
%}

<section
  id="SkineaShopConcern-{{ section.id }}"
  class="skinea-concern"
  style="
    --skinea-concern-text: {{ section.settings.text_color }};
    --skinea-concern-pink: {{ section.settings.pink_accent }};
    --skinea-concern-purple: {{ section.settings.purple_accent }};
    --skinea-concern-soft: {{ section.settings.soft_background }};
  "
>
  <div class="skinea-concern__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="skinea-concern__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    {% if section.settings.text != blank %}
      <div class="skinea-concern__text">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% if concern_blocks.size > 0 %}
    <div class="skinea-concern__slider" aria-label="Shop Skinea by concern">
      {% for block in concern_blocks %}
        <article class="skinea-concern__card" {{ block.shopify_attributes }}>
          <a class="skinea-concern__media" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 30vw, 78vw',
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'skinea-concern__placeholder' }}
            {% endif %}

            {% if block.settings.badge != blank %}
              <span class="skinea-concern__badge">{{ block.settings.badge | escape }}</span>
            {% endif %}
          </a>

          <div class="skinea-concern__content">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text | escape }}</p>
            {% endif %}

            {% if block.settings.link_label != blank %}
              <a class="skinea-concern__button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                {{ block.settings.link_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .skinea-concern {
    background:
      radial-gradient(circle at 8% 0, var(--skinea-concern-soft) 0, transparent 32rem),
      #ffffff;
    color: var(--skinea-concern-text);
    overflow: hidden;
    padding: clamp(4rem, 8vw, 9rem) clamp(1.4rem, 5vw, 6rem);
  }

  .skinea-concern * {
    box-sizing: border-box;
  }

  .skinea-concern a {
    color: inherit;
    text-decoration: none;
  }

  .skinea-concern__header {
    align-items: end;
    animation: skinea-concern-rise 700ms ease both;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 auto;
    max-width: 128rem;
  }

  .skinea-concern__eyebrow {
    color: var(--skinea-concern-purple);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin: 0 0 1.4rem;
    text-transform: uppercase;
  }

  .skinea-concern h2 {
    color: var(--skinea-concern-text);
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 6vw, 7.2rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
    max-width: 11ch;
  }

  .skinea-concern__text {
    color: rgba(37, 24, 36, 0.66);
    font-size: clamp(1.55rem, 1.7vw, 1.95rem);
    line-height: 1.65;
    max-width: 58rem;
  }

  .skinea-concern__text p {
    margin: 0;
  }

  .skinea-concern__slider {
    display: flex;
    gap: 1.4rem;
    margin: clamp(2.6rem, 5vw, 4.4rem) -1.4rem 0;
    overflow-x: auto;
    padding: 0.4rem 1.4rem 2rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .skinea-concern__slider::-webkit-scrollbar {
    display: none;
  }

  .skinea-concern__card {
    animation: skinea-concern-card 700ms ease both;
    background: rgba(255, 255, 255, 0.94);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: 2.8rem;
    box-shadow: 0 1.8rem 5.5rem rgba(37, 24, 36, 0.08);
    flex: 0 0 min(82vw, 34rem);
    overflow: hidden;
    scroll-snap-align: start;
    transition: box-shadow 220ms ease, transform 220ms ease;
  }

  .skinea-concern__card:hover {
    box-shadow: 0 2.8rem 7rem rgba(37, 24, 36, 0.14);
    transform: translateY(-0.45rem);
  }

  .skinea-concern__media {
    aspect-ratio: 1 / 1.1;
    background:
      radial-gradient(circle at 50% 16%, var(--skinea-concern-soft) 0, transparent 62%),
      #ffffff;
    display: block;
    overflow: hidden;
    position: relative;
  }

  .skinea-concern__media img,
  .skinea-concern__media svg {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
    width: 100%;
  }

  .skinea-concern__card:hover .skinea-concern__media img,
  .skinea-concern__card:hover .skinea-concern__media svg {
    transform: scale(1.04);
  }

  .skinea-concern__media::after {
    background: linear-gradient(180deg, transparent 52%, rgba(37, 24, 36, 0.36));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .skinea-concern__badge {
    backdrop-filter: blur(1.4rem);
    background: rgba(255, 255, 255, 0.84);
    border-radius: 999rem;
    bottom: 1.2rem;
    font-size: 1.1rem;
    font-weight: 800;
    left: 1.2rem;
    letter-spacing: 0.08em;
    padding: 0.7rem 1rem;
    position: absolute;
    text-transform: uppercase;
    z-index: 1;
  }

  .skinea-concern__content {
    display: flex;
    flex-direction: column;
    min-height: 20rem;
    padding: 1.8rem;
  }

  .skinea-concern h3 {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 2.6vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin: 0;
  }

  .skinea-concern__content p {
    color: rgba(37, 24, 36, 0.62);
    font-size: 1.42rem;
    line-height: 1.55;
    margin: 0.8rem 0 0;
  }

  .skinea-concern__button {
    align-items: center;
    background: linear-gradient(135deg, var(--skinea-concern-pink), var(--skinea-concern-purple));
    border-radius: 999rem;
    color: #ffffff;
    display: inline-flex;
    font-size: 1.32rem;
    font-weight: 800;
    justify-content: center;
    margin-top: auto;
    min-height: 4.4rem;
    padding: 0 1.6rem;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-concern__button:hover {
    box-shadow: 0 1.4rem 3.8rem rgba(37, 24, 36, 0.16);
    transform: translateY(-0.2rem);
  }

  .skinea-concern__placeholder {
    background: var(--skinea-concern-soft);
    fill: var(--skinea-concern-pink);
  }

  @keyframes skinea-concern-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes skinea-concern-card {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (min-width: 750px) {
    .skinea-concern__header {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .skinea-concern__card {
      flex-basis: 34rem;
    }
  }

  @media screen and (min-width: 990px) {
    .skinea-concern__slider {
      display: grid;
      gap: 1.6rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-inline: auto;
      max-width: 128rem;
      overflow: visible;
      padding: 0;
    }

    .skinea-concern__card {
      flex: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .skinea-concern {
      padding-inline: 1.4rem;
    }
  }
{% endstylesheet %}

{% schema %}

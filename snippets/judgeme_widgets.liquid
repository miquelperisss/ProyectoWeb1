{% if widget_type == 'judgeme_review_widget' and product != blank %}
  <div
    id="judgeme_product_reviews"
    class="jdgm-widget jdgm-review-widget"
    data-product-title="{{ product.title | escape }}"
    data-id="{{ product.id }}"
    data-auto-install="{{ concierge_install }}"
  ></div>
{% endif %}

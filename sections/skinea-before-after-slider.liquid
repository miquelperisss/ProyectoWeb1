<section
  id="SkineaBeforeAfter-{{ section.id }}"
  class="skinea-ba"
  style="
    --skinea-ba-text: {{ section.settings.text_color }};
    --skinea-ba-pink: {{ section.settings.pink_accent }};
    --skinea-ba-purple: {{ section.settings.purple_accent }};
    --skinea-ba-soft: {{ section.settings.soft_background }};
    --skinea-ba-position: {{ section.settings.initial_position }}%;
  "
>
  <div class="skinea-ba__inner">
    <div class="skinea-ba__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="skinea-ba__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="skinea-ba__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="skinea-ba__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>

    <skinea-before-after class="skinea-ba__comparison">
      <div class="skinea-ba__frame" data-skinea-ba-frame>
        <div class="skinea-ba__image skinea-ba__image--after">
          {% if section.settings.after_image != blank %}
            {{
              section.settings.after_image
              | image_url: width: 1400
              | image_tag:
                widths: '420, 640, 900, 1200, 1400',
                sizes: '(min-width: 990px) 52vw, 92vw',
                loading: 'lazy'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'skinea-ba__placeholder' }}
          {% endif %}
          <span>{{ section.settings.after_label | escape }}</span>
        </div>

        <div class="skinea-ba__image skinea-ba__image--before">
          {% if section.settings.before_image != blank %}
            {{
              section.settings.before_image
              | image_url: width: 1400
              | image_tag:
                widths: '420, 640, 900, 1200, 1400',
                sizes: '(min-width: 990px) 52vw, 92vw',
                loading: 'lazy'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'skinea-ba__placeholder' }}
          {% endif %}
          <span>{{ section.settings.before_label | escape }}</span>
        </div>

        <div class="skinea-ba__handle" aria-hidden="true">
          <span></span>
        </div>

        <input
          id="SkineaBeforeAfterRange-{{ section.id }}"
          class="skinea-ba__range"
          type="range"
          min="0"
          max="100"
          value="{{ section.settings.initial_position }}"
          data-skinea-ba-range
          aria-label="{{ section.settings.slider_label | escape }}"
        >
      </div>

      {% if section.settings.proof_text != blank %}
        <p class="skinea-ba__proof">{{ section.settings.proof_text | escape }}</p>
      {% endif %}
    </skinea-before-after>
  </div>
</section>

{% stylesheet %}
  .skinea-ba {
    background:
      radial-gradient(circle at 92% 0, var(--skinea-ba-soft) 0, transparent 34rem),
      #ffffff;
    color: var(--skinea-ba-text);
    overflow: hidden;
    padding: clamp(4rem, 8vw, 9rem) clamp(1.4rem, 5vw, 6rem);
  }

  .skinea-ba * {
    box-sizing: border-box;
  }

  .skinea-ba a {
    color: inherit;
    text-decoration: none;
  }

  .skinea-ba__inner {
    align-items: center;
    display: grid;
    gap: clamp(3rem, 7vw, 8rem);
    grid-template-columns: minmax(0, 1fr);
    margin: 0 auto;
    max-width: 128rem;
  }

  .skinea-ba__copy {
    animation: skinea-ba-rise 700ms ease both;
  }

  .skinea-ba__eyebrow {
    color: var(--skinea-ba-purple);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin: 0 0 1.4rem;
    text-transform: uppercase;
  }

  .skinea-ba h2 {
    color: var(--skinea-ba-text);
    font-family: var(--font-heading-family);
    font-size: clamp(3.8rem, 7vw, 8.2rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
    max-width: 10ch;
  }

  .skinea-ba__text {
    color: rgba(37, 24, 36, 0.66);
    font-size: clamp(1.55rem, 1.7vw, 2rem);
    line-height: 1.65;
    margin-top: 1.8rem;
    max-width: 56rem;
  }

  .skinea-ba__text p {
    margin: 0;
  }

  .skinea-ba__button {
    align-items: center;
    background: linear-gradient(135deg, var(--skinea-ba-pink), var(--skinea-ba-purple));
    border-radius: 999rem;
    color: #ffffff;
    display: inline-flex;
    font-size: 1.4rem;
    font-weight: 800;
    justify-content: center;
    margin-top: 3rem;
    min-height: 5rem;
    padding: 0 2.6rem;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-ba__button:hover {
    box-shadow: 0 1.6rem 4.2rem rgba(37, 24, 36, 0.16);
    transform: translateY(-0.2rem);
  }

  .skinea-ba__comparison {
    animation: skinea-ba-image 800ms ease 120ms both;
    display: block;
  }

  .skinea-ba__frame {
    aspect-ratio: 0.92;
    background: var(--skinea-ba-soft);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: clamp(2.8rem, 5vw, 5.2rem);
    box-shadow: 0 2.6rem 7rem rgba(37, 24, 36, 0.12);
    cursor: ew-resize;
    overflow: hidden;
    position: relative;
    touch-action: none;
  }

  .skinea-ba__image {
    inset: 0;
    position: absolute;
  }

  .skinea-ba__image img,
  .skinea-ba__image svg {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .skinea-ba__image--before {
    clip-path: inset(0 calc(100% - var(--skinea-ba-position)) 0 0);
    transition: clip-path 120ms ease-out;
    z-index: 2;
  }

  .skinea-ba__image span {
    backdrop-filter: blur(1.4rem);
    background: rgba(255, 255, 255, 0.84);
    border-radius: 999rem;
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.7rem 1rem;
    position: absolute;
    text-transform: uppercase;
    top: 1.4rem;
    z-index: 4;
  }

  .skinea-ba__image--before span {
    left: 1.4rem;
  }

  .skinea-ba__image--after span {
    right: 1.4rem;
  }

  .skinea-ba__handle {
    background: #ffffff;
    bottom: 0;
    box-shadow: 0 0 0 999rem rgba(255, 255, 255, 0);
    left: var(--skinea-ba-position);
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    transition: left 120ms ease-out;
    width: 0.2rem;
    z-index: 5;
  }

  .skinea-ba__handle span {
    align-items: center;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 999rem;
    box-shadow: 0 1.4rem 4rem rgba(37, 24, 36, 0.18);
    display: flex;
    height: 5.8rem;
    justify-content: center;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 5.8rem;
  }

  .skinea-ba__handle span::before,
  .skinea-ba__handle span::after {
    border-bottom: 0.55rem solid transparent;
    border-top: 0.55rem solid transparent;
    content: "";
    display: block;
    height: 0;
    width: 0;
  }

  .skinea-ba__handle span::before {
    border-right: 0.75rem solid var(--skinea-ba-text);
    margin-right: 0.35rem;
  }

  .skinea-ba__handle span::after {
    border-left: 0.75rem solid var(--skinea-ba-text);
    margin-left: 0.35rem;
  }

  .skinea-ba__range {
    appearance: none;
    background: transparent;
    cursor: ew-resize;
    height: 100%;
    inset: 0;
    margin: 0;
    opacity: 0;
    position: absolute;
    width: 100%;
    z-index: 6;
  }

  .skinea-ba__proof {
    color: rgba(37, 24, 36, 0.58);
    font-size: 1.32rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 1.4rem 0 0;
    text-align: center;
  }

  .skinea-ba__placeholder {
    background: var(--skinea-ba-soft);
    fill: var(--skinea-ba-pink);
  }

  @keyframes skinea-ba-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes skinea-ba-image {
    from {
      opacity: 0;
      transform: translateY(2.4rem) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (min-width: 990px) {
    .skinea-ba__inner {
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    }
  }

  @media screen and (max-width: 749px) {
    .skinea-ba {
      padding-inline: 1.4rem;
    }

    .skinea-ba__button {
      width: 100%;
    }

    .skinea-ba__frame {
      aspect-ratio: 0.78;
    }
  }
{% endstylesheet %}

{% javascript %}
  class SkineaBeforeAfter extends HTMLElement {
    connectedCallback() {
      this.frame = this.querySelector('[data-skinea-ba-frame]')
      this.range = this.querySelector('[data-skinea-ba-range]')

      if (!this.frame || !this.range) return

      this.updatePosition(this.range.value)
      this.range.addEventListener('input', () => this.updatePosition(this.range.value))
      this.frame.addEventListener('pointerdown', (event) => this.startDrag(event))
    }

    startDrag(event) {
      this.dragging = true
      this.frame.setPointerCapture(event.pointerId)
      this.updateFromPointer(event)
      this.frame.addEventListener('pointermove', this.handlePointerMove)
      this.frame.addEventListener('pointerup', this.handlePointerUp, { once: true })
      this.frame.addEventListener('pointercancel', this.handlePointerUp, { once: true })
    }

    handlePointerMove = (event) => {
      if (!this.dragging) return
      this.updateFromPointer(event)
    }

    handlePointerUp = () => {
      this.dragging = false
      this.frame.removeEventListener('pointermove', this.handlePointerMove)
    }

    updateFromPointer(event) {
      const rect = this.frame.getBoundingClientRect()
      const position = ((event.clientX - rect.left) / rect.width) * 100
      const clampedPosition = Math.max(0, Math.min(100, position))
      this.range.value = clampedPosition
      this.updatePosition(clampedPosition)
    }

    updatePosition(value) {
      this.style.setProperty('--skinea-ba-position', `${value}%`)
    }
  }

  if (!customElements.get('skinea-before-after')) {
    customElements.define('skinea-before-after', SkineaBeforeAfter)
  }
{% endjavascript %}

{% schema %}
{
  "name": "Skinea before after",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visible glow ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare the ritual. See the glow."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Showcase credible before-and-after skincare moments with a premium interactive slider designed to build confidence before checkout.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop glow rituals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Proof text",
      "default": "Drag the slider to compare the before and after ritual."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "text",
      "id": "slider_label",
      "label": "Slider accessibility label",
      "default": "Compare before and after images"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial slider position",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#251824"
    },
    {
      "type": "color",
      "id": "pink_accent",
      "label": "Soft pink accent",
      "default": "#f0a8c8"
    },
    {
      "type": "color",
      "id": "purple_accent",
      "label": "Soft purple accent",
      "default": "#9a78ff"
    },
    {
      "type": "color",
      "id": "soft_background",
      "label": "Soft background glow",
      "default": "#fff4fa"
    }
  ],
  "presets": [
    {
      "name": "Skinea before after"
    }
  ]
}
{% endschema %}

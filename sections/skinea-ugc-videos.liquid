{% liquid
  assign video_blocks = section.blocks | where: 'type', 'video'
%}

<section
  id="SkineaUgcVideos-{{ section.id }}"
  class="skinea-ugc"
  style="
    --skinea-ugc-text: {{ section.settings.text_color }};
    --skinea-ugc-pink: {{ section.settings.pink_accent }};
    --skinea-ugc-purple: {{ section.settings.purple_accent }};
    --skinea-ugc-soft: {{ section.settings.soft_background }};
  "
>
  <div class="skinea-ugc__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="skinea-ugc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    {% if section.settings.text != blank %}
      <div class="skinea-ugc__text">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% if video_blocks.size > 0 %}
    <skinea-ugc-carousel class="skinea-ugc__carousel">
      <div class="skinea-ugc__controls" aria-label="UGC video carousel controls">
        <button type="button" class="skinea-ugc__arrow" data-skinea-ugc-prev aria-label="Previous video">
          <span aria-hidden="true">&larr;</span>
        </button>
        <button type="button" class="skinea-ugc__arrow" data-skinea-ugc-next aria-label="Next video">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

      <div class="skinea-ugc__track" data-skinea-ugc-track>
        {% for block in video_blocks %}
          <article class="skinea-ugc__card" {{ block.shopify_attributes }}>
            <div class="skinea-ugc__media">
              {% if block.settings.hosted_video != blank %}
                {{
                  block.settings.hosted_video
                  | video_tag:
                    image_size: '900x',
                    controls: true,
                    muted: true,
                    loop: false,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'skinea-ugc__video'
                }}
                <button type="button" class="skinea-ugc__play" data-skinea-ugc-play aria-label="Play video">
                  <span aria-hidden="true"></span>
                </button>
              {% elsif block.settings.external_video_link != blank %}
                <a
                  class="skinea-ugc__external"
                  href="{{ block.settings.external_video_link }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ block.settings.external_label | escape }}"
                >
                  {% if block.settings.thumbnail != blank %}
                    {{
                      block.settings.thumbnail
                      | image_url: width: 900
                      | image_tag:
                        widths: '320, 480, 640, 900',
                        sizes: '(min-width: 990px) 24vw, 78vw',
                        loading: 'lazy',
                        class: 'skinea-ugc__thumbnail'
                    }}
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'skinea-ugc__placeholder' }}
                  {% endif %}
                  <span class="skinea-ugc__play skinea-ugc__play--link" aria-hidden="true">
                    <span></span>
                  </span>
                </a>
              {% elsif block.settings.thumbnail != blank %}
                {{
                  block.settings.thumbnail
                  | image_url: width: 900
                  | image_tag:
                    widths: '320, 480, 640, 900',
                    sizes: '(min-width: 990px) 24vw, 78vw',
                    loading: 'lazy',
                    class: 'skinea-ugc__thumbnail'
                }}
                <span class="skinea-ugc__play skinea-ugc__play--link" aria-hidden="true">
                  <span></span>
                </span>
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'skinea-ugc__placeholder' }}
                <span class="skinea-ugc__play skinea-ugc__play--link" aria-hidden="true">
                  <span></span>
                </span>
              {% endif %}

              {% if block.settings.platform_label != blank %}
                <span class="skinea-ugc__platform">{{ block.settings.platform_label | escape }}</span>
              {% endif %}
            </div>

            <div class="skinea-ugc__caption">
              {% if block.settings.caption != blank %}
                <blockquote>{{ block.settings.caption | escape }}</blockquote>
              {% endif %}

              <div class="skinea-ugc__customer">
                {% if block.settings.profile_image != blank %}
                  <div class="skinea-ugc__avatar">
                    {{
                      block.settings.profile_image
                      | image_url: width: 160
                      | image_tag:
                        widths: '80, 120, 160',
                        sizes: '48px',
                        loading: 'lazy'
                    }}
                  </div>
                {% elsif block.settings.customer_initials != blank %}
                  <div class="skinea-ugc__avatar">
                    <span>{{ block.settings.customer_initials | escape }}</span>
                  </div>
                {% endif %}

                <div>
                  {% if block.settings.customer_name != blank %}
                    <p class="skinea-ugc__name">{{ block.settings.customer_name | escape }}</p>
                  {% endif %}
                  {% if block.settings.customer_detail != blank %}
                    <p class="skinea-ugc__detail">{{ block.settings.customer_detail | escape }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </skinea-ugc-carousel>
  {% endif %}
</section>

{% stylesheet %}
  .skinea-ugc {
    background:
      radial-gradient(circle at 90% 0, var(--skinea-ugc-soft) 0, transparent 32rem),
      #ffffff;
    color: var(--skinea-ugc-text);
    overflow: hidden;
    padding: clamp(4rem, 8vw, 9rem) clamp(1.4rem, 5vw, 6rem);
  }

  .skinea-ugc * {
    box-sizing: border-box;
  }

  .skinea-ugc__header {
    align-items: end;
    animation: skinea-ugc-rise 700ms ease both;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 auto;
    max-width: 128rem;
  }

  .skinea-ugc__eyebrow {
    color: var(--skinea-ugc-purple);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin: 0 0 1.4rem;
    text-transform: uppercase;
  }

  .skinea-ugc h2 {
    color: var(--skinea-ugc-text);
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 6vw, 7.2rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
    max-width: 11ch;
  }

  .skinea-ugc__text {
    color: rgba(37, 24, 36, 0.66);
    font-size: clamp(1.55rem, 1.7vw, 1.95rem);
    line-height: 1.65;
    max-width: 56rem;
  }

  .skinea-ugc__text p {
    margin: 0;
  }

  .skinea-ugc__carousel {
    display: block;
    margin: clamp(2.4rem, 5vw, 4rem) auto 0;
    max-width: 128rem;
    position: relative;
  }

  .skinea-ugc__controls {
    display: flex;
    gap: 0.8rem;
    justify-content: flex-end;
    margin-bottom: 1.2rem;
  }

  .skinea-ugc__arrow {
    align-items: center;
    background: #ffffff;
    border: 0.1rem solid rgba(37, 24, 36, 0.1);
    border-radius: 999rem;
    box-shadow: 0 1rem 3rem rgba(37, 24, 36, 0.08);
    color: var(--skinea-ugc-text);
    cursor: pointer;
    display: inline-flex;
    height: 4.4rem;
    justify-content: center;
    transition: background 180ms ease, box-shadow 180ms ease, color 180ms ease, transform 180ms ease;
    width: 4.4rem;
  }

  .skinea-ugc__arrow:hover {
    background: linear-gradient(135deg, var(--skinea-ugc-pink), var(--skinea-ugc-purple));
    box-shadow: 0 1.4rem 4rem rgba(37, 24, 36, 0.14);
    color: #ffffff;
    transform: translateY(-0.2rem);
  }

  .skinea-ugc__track {
    display: flex;
    gap: 1.4rem;
    margin-inline: -1.4rem;
    overflow-x: auto;
    padding: 0.4rem 1.4rem 1.8rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .skinea-ugc__track::-webkit-scrollbar {
    display: none;
  }

  .skinea-ugc__card {
    animation: skinea-ugc-card 700ms ease both;
    background: rgba(255, 255, 255, 0.94);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: 2.8rem;
    box-shadow: 0 1.8rem 5.5rem rgba(37, 24, 36, 0.08);
    flex: 0 0 min(82vw, 34rem);
    overflow: hidden;
    scroll-snap-align: start;
    transition: box-shadow 220ms ease, transform 220ms ease;
  }

  .skinea-ugc__card:hover {
    box-shadow: 0 2.6rem 7rem rgba(37, 24, 36, 0.13);
    transform: translateY(-0.4rem);
  }

  .skinea-ugc__media {
    aspect-ratio: 9 / 16;
    background: var(--skinea-ugc-soft);
    overflow: hidden;
    position: relative;
  }

  .skinea-ugc__video,
  .skinea-ugc__thumbnail,
  .skinea-ugc__placeholder,
  .skinea-ugc__external {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .skinea-ugc__external {
    color: inherit;
    text-decoration: none;
  }

  .skinea-ugc__external img,
  .skinea-ugc__media > img,
  .skinea-ugc__media > svg {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .skinea-ugc__media::after {
    background: linear-gradient(180deg, transparent 48%, rgba(37, 24, 36, 0.42));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .skinea-ugc__play {
    align-items: center;
    backdrop-filter: blur(1.4rem);
    background: rgba(255, 255, 255, 0.86);
    border: 0;
    border-radius: 999rem;
    box-shadow: 0 1.4rem 4rem rgba(37, 24, 36, 0.16);
    cursor: pointer;
    display: inline-flex;
    height: 6rem;
    justify-content: center;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 180ms ease, transform 180ms ease;
    width: 6rem;
    z-index: 2;
  }

  .skinea-ugc__play span {
    border-bottom: 1rem solid transparent;
    border-left: 1.45rem solid var(--skinea-ugc-text);
    border-top: 1rem solid transparent;
    display: block;
    height: 0;
    margin-left: 0.3rem;
    width: 0;
  }

  .skinea-ugc__card:hover .skinea-ugc__play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .skinea-ugc__card.is-playing .skinea-ugc__play {
    opacity: 0;
  }

  .skinea-ugc__platform {
    backdrop-filter: blur(1.4rem);
    background: rgba(255, 255, 255, 0.84);
    border-radius: 999rem;
    bottom: 1.2rem;
    font-size: 1.1rem;
    font-weight: 800;
    left: 1.2rem;
    letter-spacing: 0.08em;
    padding: 0.7rem 1rem;
    position: absolute;
    text-transform: uppercase;
    z-index: 2;
  }

  .skinea-ugc__caption {
    padding: 1.8rem;
  }

  .skinea-ugc blockquote {
    color: var(--skinea-ugc-text);
    font-family: var(--font-heading-family);
    font-size: clamp(1.95rem, 2.1vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1.18;
    margin: 0;
  }

  .skinea-ugc__customer {
    align-items: center;
    border-top: 0.1rem solid rgba(37, 24, 36, 0.08);
    display: flex;
    gap: 1rem;
    margin-top: 1.6rem;
    padding-top: 1.4rem;
  }

  .skinea-ugc__avatar {
    align-items: center;
    background: linear-gradient(135deg, var(--skinea-ugc-pink), var(--skinea-ugc-purple));
    border-radius: 999rem;
    color: #ffffff;
    display: inline-flex;
    flex: 0 0 4.8rem;
    font-size: 1.25rem;
    font-weight: 800;
    height: 4.8rem;
    justify-content: center;
    overflow: hidden;
    width: 4.8rem;
  }

  .skinea-ugc__avatar img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .skinea-ugc__name,
  .skinea-ugc__detail {
    margin: 0;
  }

  .skinea-ugc__name {
    font-size: 1.42rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .skinea-ugc__detail {
    color: rgba(37, 24, 36, 0.58);
    font-size: 1.25rem;
    line-height: 1.35;
    margin-top: 0.2rem;
  }

  .skinea-ugc__placeholder {
    background: var(--skinea-ugc-soft);
    fill: var(--skinea-ugc-pink);
  }

  @keyframes skinea-ugc-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes skinea-ugc-card {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (min-width: 750px) {
    .skinea-ugc__header {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .skinea-ugc__card {
      flex-basis: 34rem;
    }
  }

  @media screen and (min-width: 990px) {
    .skinea-ugc__controls {
      display: none;
    }

    .skinea-ugc__track {
      display: grid;
      gap: 1.6rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-inline: 0;
      overflow: visible;
      padding: 0;
    }

    .skinea-ugc__card {
      flex: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .skinea-ugc {
      padding-inline: 1.4rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  class SkineaUgcCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-skinea-ugc-track]')
      this.previousButton = this.querySelector('[data-skinea-ugc-prev]')
      this.nextButton = this.querySelector('[data-skinea-ugc-next]')
      this.playButtons = this.querySelectorAll('[data-skinea-ugc-play]')

      if (this.previousButton && this.nextButton && this.track) {
        this.previousButton.addEventListener('click', () => this.scrollCards(-1))
        this.nextButton.addEventListener('click', () => this.scrollCards(1))
      }

      this.playButtons.forEach((button) => {
        button.addEventListener('click', () => this.toggleVideo(button))
      })
    }

    scrollCards(direction) {
      this.track.scrollBy({
        left: this.track.clientWidth * 0.84 * direction,
        behavior: 'smooth',
      })
    }

    toggleVideo(button) {
      const card = button.closest('.skinea-ugc__card')
      const video = card && card.querySelector('video')
      if (!video) return

      if (video.paused) {
        video.play()
        card.classList.add('is-playing')
      } else {
        video.pause()
        card.classList.remove('is-playing')
      }

      video.addEventListener('pause', () => card.classList.remove('is-playing'), { once: true })
    }
  }

  if (!customElements.get('skinea-ugc-carousel')) {
    customElements.define('skinea-ugc-carousel', SkineaUgcCarousel)
  }
{% endjavascript %}


{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign result_blocks = section.blocks | where: 'type', 'result'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
%}

<section
  id="SkineaPremiumProductPage-{{ section.id }}"
  class="skinea-product-page"
  style="
    --skinea-product-text: {{ section.settings.text_color }};
    --skinea-product-pink: {{ section.settings.pink_accent }};
    --skinea-product-purple: {{ section.settings.purple_accent }};
    --skinea-product-soft: {{ section.settings.soft_background }};
  "
>
  <div class="skinea-product-page__intro">
    <div class="skinea-product-page__intro-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="skinea-product-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="skinea-product-page__text">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="skinea-product-page__image-card">
      {% if section.settings.lifestyle_image != blank %}
        {{
          section.settings.lifestyle_image
          | image_url: width: 1400
          | image_tag:
            widths: '420, 640, 900, 1200, 1400',
            sizes: '(min-width: 990px) 45vw, 92vw',
            loading: 'lazy',
            class: 'skinea-product-page__image'
        }}
      {% elsif product.featured_image != blank %}
        {{
          product.featured_image
          | image_url: width: 1400
          | image_tag:
            widths: '420, 640, 900, 1200, 1400',
            sizes: '(min-width: 990px) 45vw, 92vw',
            loading: 'lazy',
            class: 'skinea-product-page__image'
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'skinea-product-page__placeholder' }}
      {% endif %}

      {% if section.settings.image_badge != blank %}
        <div class="skinea-product-page__image-badge">{{ section.settings.image_badge | escape }}</div>
      {% endif %}
    </div>
  </div>

  {% if benefit_blocks.size > 0 %}
    <div class="skinea-product-page__benefits" aria-label="Product benefits">
      {% for block in benefit_blocks %}
        <article class="skinea-product-page__benefit" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <span aria-hidden="true">{{ block.settings.icon | escape }}</span>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title | escape }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>{{ block.settings.text | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if result_blocks.size > 0 %}
    <div class="skinea-product-page__section-heading">
      {% if section.settings.results_eyebrow != blank %}
        <p class="skinea-product-page__eyebrow">{{ section.settings.results_eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.results_heading != blank %}
        <h2>{{ section.settings.results_heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="skinea-product-page__results">
      {% for block in result_blocks %}
        <article class="skinea-product-page__result" {{ block.shopify_attributes }}>
          <div class="skinea-product-page__result-media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 30vw, 88vw',
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'skinea-product-page__placeholder' }}
            {% endif %}

            <div class="skinea-product-page__result-labels">
              <span>{{ block.settings.before_label | escape }}</span>
              <span>{{ block.settings.after_label | escape }}</span>
            </div>
          </div>

          <div class="skinea-product-page__card-copy">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if step_blocks.size > 0 %}
    <div class="skinea-product-page__section-heading">
      {% if section.settings.steps_eyebrow != blank %}
        <p class="skinea-product-page__eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.steps_heading != blank %}
        <h2>{{ section.settings.steps_heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="skinea-product-page__steps">
      {% for block in step_blocks %}
        <article class="skinea-product-page__step" {{ block.shopify_attributes }}>
          <span>{{ forloop.index }}</span>
          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if review_blocks.size > 0 %}
    <div class="skinea-product-page__section-heading">
      {% if section.settings.reviews_eyebrow != blank %}
        <p class="skinea-product-page__eyebrow">{{ section.settings.reviews_eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.reviews_heading != blank %}
        <h2>{{ section.settings.reviews_heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="skinea-product-page__reviews">
      {% for block in review_blocks %}
        <article class="skinea-product-page__review" {{ block.shopify_attributes }}>
          <p class="skinea-product-page__stars">{{ block.settings.rating | escape }}</p>
          {% if block.settings.quote != blank %}
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
          {% endif %}
          {% if block.settings.author != blank %}
            <p>{{ block.settings.author | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if faq_blocks.size > 0 %}
    <div class="skinea-product-page__faq">
      <div class="skinea-product-page__section-heading">
        {% if section.settings.faq_eyebrow != blank %}
          <p class="skinea-product-page__eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.faq_heading != blank %}
          <h2>{{ section.settings.faq_heading | escape }}</h2>
        {% endif %}
      </div>

      <div class="skinea-product-page__faq-list">
        {% for block in faq_blocks %}
          <details class="skinea-product-page__faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div>{{ block.settings.answer }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if section.settings.enable_mobile_sticky_atc and product != blank and current_variant != blank %}
    <div class="skinea-product-page__sticky" aria-label="Mobile add to cart">
      <div class="skinea-product-page__sticky-product">
        {% if product.featured_image != blank %}
          {{
            product.featured_image
            | image_url: width: 120
            | image_tag:
              widths: '80, 120',
              sizes: '52px',
              loading: 'lazy'
          }}
        {% endif %}
        <div>
          <strong>{{ product.title | escape }}</strong>
          <span>{{ current_variant.price | money }}</span>
        </div>
      </div>

      {% form 'product', product, class: 'skinea-product-page__sticky-form' %}
        {% if product.variants.size > 1 %}
          <label class="visually-hidden" for="SkineaProductStickyVariant-{{ section.id }}">
            {{ section.settings.variant_label | escape }}
          </label>
          <select id="SkineaProductStickyVariant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected="selected"{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title | escape }}{% unless variant.available %} - {{ section.settings.sold_out_label | escape }}{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        <button type="submit" {% unless current_variant.available %}disabled{% endunless %}>
          {% if current_variant.available %}
            {{ section.settings.add_to_cart_label | escape }}
          {% else %}
            {{ section.settings.sold_out_label | escape }}
          {% endif %}
        </button>
      {% endform %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .skinea-product-page {
    background: #ffffff;
    color: var(--skinea-product-text);
    overflow: clip;
    padding: clamp(3.6rem, 7vw, 8rem) clamp(1.6rem, 5vw, 6rem);
  }

  .skinea-product-page * {
    box-sizing: border-box;
  }

  .skinea-product-page__intro,
  .skinea-product-page__benefits,
  .skinea-product-page__results,
  .skinea-product-page__steps,
  .skinea-product-page__reviews,
  .skinea-product-page__faq {
    margin-inline: auto;
    max-width: 128rem;
  }

  .skinea-product-page__intro {
    align-items: center;
    display: grid;
    gap: clamp(2.4rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 1fr);
  }

  .skinea-product-page__intro-copy,
  .skinea-product-page__section-heading {
    animation: skinea-product-page-rise 700ms ease both;
  }

  .skinea-product-page__eyebrow {
    color: var(--skinea-product-purple);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin: 0 0 1.4rem;
    text-transform: uppercase;
  }

  .skinea-product-page h2 {
    color: var(--skinea-product-text);
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 6vw, 7.2rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
    max-width: 11ch;
  }

  .skinea-product-page__text {
    color: rgba(37, 24, 36, 0.68);
    font-size: clamp(1.6rem, 1.7vw, 2rem);
    line-height: 1.65;
    margin-top: 1.8rem;
    max-width: 58rem;
  }

  .skinea-product-page__text p {
    margin: 0;
  }

  .skinea-product-page__image-card {
    animation: skinea-product-page-image 800ms ease 120ms both;
    background:
      radial-gradient(circle at 50% 16%, var(--skinea-product-soft) 0%, #ffffff 62%),
      #ffffff;
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: clamp(2.8rem, 5vw, 5.2rem);
    box-shadow: 0 2.4rem 7rem rgba(37, 24, 36, 0.1);
    min-height: clamp(38rem, 52vw, 66rem);
    overflow: hidden;
    position: relative;
  }

  .skinea-product-page__image,
  .skinea-product-page__image-card > svg,
  .skinea-product-page__result-media img,
  .skinea-product-page__result-media svg {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .skinea-product-page__image-badge {
    backdrop-filter: blur(1.6rem);
    background: rgba(255, 255, 255, 0.84);
    border: 0.1rem solid rgba(255, 255, 255, 0.72);
    border-radius: 1.8rem;
    bottom: 1.6rem;
    box-shadow: 0 1.4rem 4rem rgba(37, 24, 36, 0.12);
    font-size: 1.3rem;
    font-weight: 800;
    left: 1.6rem;
    max-width: 24rem;
    padding: 1.2rem 1.4rem;
    position: absolute;
  }

  .skinea-product-page__benefits,
  .skinea-product-page__results,
  .skinea-product-page__steps,
  .skinea-product-page__reviews {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(2.4rem, 5vw, 4rem);
  }

  .skinea-product-page__benefits {
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .skinea-product-page__benefit,
  .skinea-product-page__result,
  .skinea-product-page__step,
  .skinea-product-page__review,
  .skinea-product-page__faq-item {
    background: rgba(255, 255, 255, 0.92);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    box-shadow: 0 1.6rem 5rem rgba(37, 24, 36, 0.07);
  }

  .skinea-product-page__benefit {
    border-radius: 2.4rem;
    padding: 1.8rem;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-product-page__benefit:hover,
  .skinea-product-page__result:hover,
  .skinea-product-page__step:hover,
  .skinea-product-page__review:hover {
    box-shadow: 0 2.4rem 6rem rgba(37, 24, 36, 0.12);
    transform: translateY(-0.3rem);
  }

  .skinea-product-page__benefit > span,
  .skinea-product-page__step > span {
    align-items: center;
    background: linear-gradient(135deg, var(--skinea-product-pink), var(--skinea-product-purple));
    border-radius: 999rem;
    color: #ffffff;
    display: inline-flex;
    font-size: 1.3rem;
    font-weight: 800;
    height: 4.2rem;
    justify-content: center;
    margin-bottom: 1.5rem;
    width: 4.2rem;
  }

  .skinea-product-page h3 {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 2.2vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin: 0;
  }

  .skinea-product-page__benefit p,
  .skinea-product-page__card-copy p,
  .skinea-product-page__step p,
  .skinea-product-page__review > p,
  .skinea-product-page__faq-item div {
    color: rgba(37, 24, 36, 0.62);
    font-size: 1.38rem;
    line-height: 1.58;
    margin: 0.7rem 0 0;
  }

  .skinea-product-page__section-heading {
    margin: clamp(5rem, 9vw, 9rem) auto 0;
    max-width: 128rem;
  }

  .skinea-product-page__result {
    border-radius: 2.6rem;
    overflow: hidden;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-product-page__result-media {
    aspect-ratio: 1 / 1.08;
    background: var(--skinea-product-soft);
    overflow: hidden;
    position: relative;
  }

  .skinea-product-page__result-labels {
    bottom: 1.2rem;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 1fr 1fr;
    left: 1.2rem;
    position: absolute;
    right: 1.2rem;
  }

  .skinea-product-page__result-labels span {
    backdrop-filter: blur(1.4rem);
    background: rgba(255, 255, 255, 0.82);
    border-radius: 999rem;
    font-size: 1.12rem;
    font-weight: 800;
    padding: 0.8rem 1rem;
    text-align: center;
  }

  .skinea-product-page__card-copy,
  .skinea-product-page__step,
  .skinea-product-page__review {
    padding: 1.8rem;
  }

  .skinea-product-page__step,
  .skinea-product-page__review {
    border-radius: 2.4rem;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-product-page__stars {
    color: var(--skinea-product-purple);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin: 0 0 1.2rem;
    text-transform: uppercase;
  }

  .skinea-product-page__review blockquote {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 2.2vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1.18;
    margin: 0;
  }

  .skinea-product-page__faq {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(5rem, 9vw, 9rem);
  }

  .skinea-product-page__faq .skinea-product-page__section-heading {
    margin-top: 0;
  }

  .skinea-product-page__faq-list {
    display: grid;
    gap: 1rem;
  }

  .skinea-product-page__faq-item {
    border-radius: 1.8rem;
    padding: 0.4rem 1.6rem;
  }

  .skinea-product-page__faq-item summary {
    cursor: pointer;
    font-size: 1.55rem;
    font-weight: 800;
    list-style: none;
    padding: 1.4rem 0;
  }

  .skinea-product-page__faq-item summary::-webkit-details-marker {
    display: none;
  }

  .skinea-product-page__faq-item div {
    padding-bottom: 1.5rem;
  }

  .skinea-product-page__sticky {
    align-items: center;
    backdrop-filter: blur(1.8rem);
    background: rgba(255, 255, 255, 0.92);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: 2rem;
    bottom: 1.2rem;
    box-shadow: 0 1.8rem 6rem rgba(37, 24, 36, 0.18);
    display: grid;
    gap: 1rem;
    left: 1.2rem;
    padding: 1rem;
    position: fixed;
    right: 1.2rem;
    z-index: 40;
  }

  .skinea-product-page__sticky-product {
    align-items: center;
    display: flex;
    gap: 1rem;
    min-width: 0;
  }

  .skinea-product-page__sticky-product img {
    border-radius: 1.2rem;
    height: 5.2rem;
    object-fit: cover;
    width: 5.2rem;
  }

  .skinea-product-page__sticky-product strong,
  .skinea-product-page__sticky-product span {
    display: block;
  }

  .skinea-product-page__sticky-product strong {
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .skinea-product-page__sticky-product span {
    color: rgba(37, 24, 36, 0.62);
    font-size: 1.25rem;
    margin-top: 0.2rem;
  }

  .skinea-product-page__sticky-form {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .skinea-product-page__sticky-form select,
  .skinea-product-page__sticky-form button {
    border-radius: 999rem;
    font: inherit;
    font-size: 1.35rem;
    font-weight: 800;
    min-height: 4.6rem;
    padding: 0 1.4rem;
    width: 100%;
  }

  .skinea-product-page__sticky-form select {
    background: #ffffff;
    border: 0.1rem solid rgba(37, 24, 36, 0.12);
    color: var(--skinea-product-text);
  }

  .skinea-product-page__sticky-form button {
    background: linear-gradient(135deg, var(--skinea-product-pink), var(--skinea-product-purple));
    border: 0;
    color: #ffffff;
    cursor: pointer;
  }

  .skinea-product-page__sticky-form button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .skinea-product-page__placeholder {
    background: var(--skinea-product-soft);
    fill: var(--skinea-product-pink);
  }

  @keyframes skinea-product-page-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes skinea-product-page-image {
    from {
      opacity: 0;
      transform: translateY(2.4rem) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (min-width: 750px) {
    .skinea-product-page__benefits,
    .skinea-product-page__results,
    .skinea-product-page__steps,
    .skinea-product-page__reviews {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .skinea-product-page__intro {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .skinea-product-page__faq {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .skinea-product-page__sticky {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .skinea-product-page {
      padding-inline: 1.4rem;
    }

    .skinea-product-page__image-card {
      min-height: 38rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Skinea product page",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium skincare technology"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Results-focused self-care, designed for your daily ritual"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Show customers why this Skinea tool feels premium, effective and easy to make part of a modern skincare routine.</p>"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "image_badge",
      "label": "Image badge",
      "default": "A spa-inspired ritual made for glowing skin days."
    },
    {
      "type": "header",
      "content": "Section headings"
    },
    {
      "type": "text",
      "id": "results_eyebrow",
      "label": "Results eyebrow",
      "default": "Before and after"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "Results heading",
      "default": "Show the visible ritual"
    },
    {
      "type": "text",
      "id": "steps_eyebrow",
      "label": "Steps eyebrow",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Steps heading",
      "default": "Simple steps for a polished glow"
    },
    {
      "type": "text",
      "id": "reviews_eyebrow",
      "label": "Reviews eyebrow",
      "default": "Social proof"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "Loved by glow ritual customers"
    },
    {
      "type": "text",
      "id": "faq_eyebrow",
      "label": "FAQ eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ heading",
      "default": "Confidence before checkout"
    },
    {
      "type": "header",
      "content": "Mobile sticky add to cart"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_sticky_atc",
      "label": "Enable mobile sticky add to cart",
      "default": true

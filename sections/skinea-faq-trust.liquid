{% liquid
  assign trust_blocks = section.blocks | where: 'type', 'trust_badge'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
%}

<section
  id="SkineaFaqTrust-{{ section.id }}"
  class="skinea-faq-trust"
  style="
    --skinea-faq-text: {{ section.settings.text_color }};
    --skinea-faq-pink: {{ section.settings.pink_accent }};
    --skinea-faq-purple: {{ section.settings.purple_accent }};
    --skinea-faq-soft: {{ section.settings.soft_background }};
  "
>
  <div class="skinea-faq-trust__inner">
    <div class="skinea-faq-trust__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="skinea-faq-trust__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="skinea-faq-trust__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if trust_blocks.size > 0 %}
        <div class="skinea-faq-trust__badges" aria-label="Store trust information">
          {% for block in trust_blocks %}
            <article class="skinea-faq-trust__badge" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span aria-hidden="true">{{ block.settings.icon | escape }}</span>
              {% endif %}

              <div>
                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title | escape }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p>{{ block.settings.text | escape }}</p>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if faq_blocks.size > 0 %}
      <div class="skinea-faq-trust__accordion">
        {% for block in faq_blocks %}
          <details class="skinea-faq-trust__item" {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question | escape }}</span>
              <span class="skinea-faq-trust__plus" aria-hidden="true"></span>
            </summary>
            <div class="skinea-faq-trust__answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .skinea-faq-trust {
    background:
      radial-gradient(circle at 8% 0, var(--skinea-faq-soft) 0, transparent 34rem),
      #ffffff;
    color: var(--skinea-faq-text);
    overflow: hidden;
    padding: clamp(4rem, 8vw, 9rem) clamp(1.4rem, 5vw, 6rem);
  }

  .skinea-faq-trust * {
    box-sizing: border-box;
  }

  .skinea-faq-trust__inner {
    align-items: start;
    display: grid;
    gap: clamp(2.4rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 1fr);
    margin: 0 auto;
    max-width: 128rem;
  }

  .skinea-faq-trust__copy,
  .skinea-faq-trust__accordion {
    animation: skinea-faq-rise 700ms ease both;
  }

  .skinea-faq-trust__eyebrow {
    color: var(--skinea-faq-purple);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin: 0 0 1.4rem;
    text-transform: uppercase;
  }

  .skinea-faq-trust h2 {
    color: var(--skinea-faq-text);
    font-family: var(--font-heading-family);
    font-size: clamp(3.4rem, 6vw, 7.2rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
    margin: 0;
    max-width: 11ch;
  }

  .skinea-faq-trust__text {
    color: rgba(37, 24, 36, 0.66);
    font-size: clamp(1.55rem, 1.7vw, 1.95rem);
    line-height: 1.65;
    margin-top: 1.8rem;
    max-width: 58rem;
  }

  .skinea-faq-trust__text p {
    margin: 0;
  }

  .skinea-faq-trust__badges {
    display: grid;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  .skinea-faq-trust__badge {
    align-items: flex-start;
    background: rgba(255, 255, 255, 0.92);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: 2rem;
    box-shadow: 0 1.4rem 4rem rgba(37, 24, 36, 0.06);
    display: flex;
    gap: 1.2rem;
    padding: 1.5rem;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-faq-trust__badge:hover {
    box-shadow: 0 2rem 5rem rgba(37, 24, 36, 0.1);
    transform: translateY(-0.25rem);
  }

  .skinea-faq-trust__badge > span {
    align-items: center;
    background: linear-gradient(135deg, var(--skinea-faq-pink), var(--skinea-faq-purple));
    border-radius: 999rem;
    color: #ffffff;
    display: inline-flex;
    flex: 0 0 4.4rem;
    font-size: 1.4rem;
    font-weight: 800;
    height: 4.4rem;
    justify-content: center;
    width: 4.4rem;
  }

  .skinea-faq-trust h3 {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0;
  }

  .skinea-faq-trust__badge p,
  .skinea-faq-trust__answer {
    color: rgba(37, 24, 36, 0.62);
    font-size: 1.38rem;
    line-height: 1.58;
    margin: 0.5rem 0 0;
  }

  .skinea-faq-trust__accordion {
    display: grid;
    gap: 1rem;
  }

  .skinea-faq-trust__item {
    background: rgba(255, 255, 255, 0.94);
    border: 0.1rem solid rgba(37, 24, 36, 0.08);
    border-radius: 2rem;
    box-shadow: 0 1.6rem 5rem rgba(37, 24, 36, 0.07);
    overflow: hidden;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .skinea-faq-trust__item:hover {
    box-shadow: 0 2.2rem 6rem rgba(37, 24, 36, 0.11);
    transform: translateY(-0.2rem);
  }

  .skinea-faq-trust__item summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-size: 1.58rem;
    font-weight: 800;
    gap: 1.2rem;
    justify-content: space-between;
    list-style: none;
    padding: 1.7rem 1.8rem;
  }

  .skinea-faq-trust__item summary::-webkit-details-marker {
    display: none;
  }

  .skinea-faq-trust__plus {
    background: linear-gradient(135deg, var(--skinea-faq-pink), var(--skinea-faq-purple));
    border-radius: 999rem;
    flex: 0 0 3.2rem;
    height: 3.2rem;
    position: relative;
    transition: transform 220ms ease;
    width: 3.2rem;
  }

  .skinea-faq-trust__plus::before,
  .skinea-faq-trust__plus::after {
    background: #ffffff;
    border-radius: 999rem;
    content: "";
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .skinea-faq-trust__plus::before {
    height: 0.2rem;
    width: 1.3rem;
  }

  .skinea-faq-trust__plus::after {
    height: 1.3rem;
    width: 0.2rem;
  }

  .skinea-faq-trust__item[open] .skinea-faq-trust__plus {
    transform: rotate(45deg);
  }

  .skinea-faq-trust__answer {
    display: grid;
    grid-template-rows: 1fr;
    margin: 0;
    padding: 0 1.8rem 1.8rem;
  }

  .skinea-faq-trust__answer p {
    margin: 0;
  }

  @keyframes skinea-faq-rise {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (min-width: 750px) {
    .skinea-faq-trust__badges {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .skinea-faq-trust__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .skinea-faq-trust__badges {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .skinea-faq-trust {
      padding-inline: 1.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Skinea FAQ trust",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions and trust"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything to know before your glow ritual"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Answer common questions and show key trust signals so shoppers feel confident before checkout.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#251824"
    },
    {
      "type": "color",
      "id": "pink_accent",
      "label": "Soft pink accent",
      "default": "#f0a8c8"
    },
    {
      "type": "color",
      "id": "purple_accent",
      "label": "Soft purple accent",
      "default": "#9a78ff"
    },
    {
      "type": "color",
      "id": "soft_background",
      "label": "Soft background glow",
      "default": "#fff4fa"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon text",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast tracked shipping"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Clear delivery updates from order confirmation to arrival."
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Shipping times can be edited to match your store policy. Add your processing time, delivery estimate and tracking details here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skinea FAQ trust",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "01",
            "title": "Shipping information",
            "text": "Tracked shipping with updates so customers always know where their Skinea order is."
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "02",
            "title": "Easy returns",
            "text": "Clear return information helps shoppers feel confident before they buy."
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "03",
            "title": "Secure checkout",
            "text": "Encrypted checkout and trusted payment options for a premium shopping experience."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Shipping times depend on your destination and chosen shipping method. Add your store's exact processing and delivery estimates here.</p>"
          }
        },
        {
          "type": "faq",

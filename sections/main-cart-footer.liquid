<section
  class="cart-footer-section{% if cart == empty %} is-hidden{% endif %}"
  data-cart-footer
  {% if cart == empty %}hidden{% endif %}
>
  <div class="cart-footer-section__inner">
    <div class="cart-footer__note">
      <h2>Ready for the course?</h2>
      <p>Checkout is secure and your order will be processed by Shopify.</p>
    </div>

    <div class="cart-summary">
      <div class="cart-summary__row">
        <span>Subtotal</span>
        <strong data-cart-subtotal>{{ cart.total_price | money }} AUD</strong>
      </div>
      <p class="cart-summary__tax-note">
        Taxes, discounts, and shipping calculated at checkout.
      </p>

      <form action="{{ routes.cart_url }}" method="post" id="CartCheckoutForm">
        <button
          class="cart-button cart-button--primary cart-button--full"
          type="submit"
          name="checkout"
          {% if cart == empty %}disabled{% endif %}
          data-cart-checkout
        >
          Checkout
        </button>
      </form>

      <a class="cart-button cart-button--secondary cart-button--full" href="{{ routes.all_products_collection_url }}">
        Continue Shopping
      </a>

      <div class="cart-summary__trust">
        <span>🔒 Secure checkout</span>
        <span>📦 Fast dispatch</span>
        <span>↩️ 30-day returns</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart footer",
  "settings": []
}
{% endschema %}

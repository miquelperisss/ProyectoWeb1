          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Puffiness"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Cool, refresh and awaken tired skin."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Morning ritual"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skinea mega menu",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category",
          "settings": {
            "title": "Sculpting",
            "text": "Define the look of cheeks and jawline.",
            "badge": "Lift ritual"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Anti-aging",
            "text": "Support smoother-looking skin rituals.",
            "badge": "Skin tech"
          }

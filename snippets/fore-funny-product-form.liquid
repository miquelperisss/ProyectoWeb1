{% doc %}
Renders the Fore & Funny product variant selector, add-to-cart form, and dynamic checkout button.
@param {product} product - Product used for the Fore & Funny landing page
@example
{% render 'fore-funny-product-form', product: product %}
{% enddoc %}

{% liquid
  assign landing_product = product
  assign selected_variant = landing_product.selected_or_first_available_variant

  if landing_product != blank
    for variant in landing_product.variants
      if variant.title contains '500'
        continue
      elsif variant.title contains '50'
        assign selected_variant = variant
      endif
    endfor
  endif
%}

<script type="application/json" id="ForeFunnyProductData">
  {
    "variants": {% if landing_product != blank %}{{ landing_product.variants | json }}{% else %}[]{% endif %}
  }
</script>

{% if landing_product != blank %}
  {% form 'product', landing_product, id: 'ForeFunnyProductForm', class: 'fore-funny-product-form' %}
    <p class="pack-label">Choose your pack</p>
    <div class="packs">
      {% for variant in landing_product.variants %}
        {% liquid
          assign pack_size = forloop.index
          if variant.title contains '500'
            assign pack_size = '500'
          elsif variant.title contains '100'
            assign pack_size = '100'
          elsif variant.title contains '50'
            assign pack_size = '50'
          elsif variant.title contains '10'
            assign pack_size = '10'
          endif

          assign pack_number = pack_size | plus: 0
          assign per_tee_price = variant.price | divided_by: pack_number | money
          assign per_tee_text = per_tee_price | append: ' per tee'

          if pack_size == '100'
            assign per_tee_text = per_tee_text | append: ' — save 13%'
          elsif pack_size == '500'
            assign per_tee_text = per_tee_text | append: ' — best value'
          endif
        %}
        <button
          type="button"
          class="pack-option{% if variant.id == selected_variant.id %} selected{% endif %}"
          data-pack="{{ pack_size }}"
          data-variant-id="{{ variant.id }}"
          onclick="selectPack(this)"
          {% unless variant.available %}disabled{% endunless %}
        >
          {% if pack_size == '50' %}
            <div class="pack-popular">⭐ Most Popular</div>
          {% endif %}
          <div class="pack-qty">× {{ pack_size }} tees</div>
          <div class="pack-price">{{ variant.price | money }}</div>
          <div class="pack-per">{{ per_tee_text }}</div>
        </button>
      {% endfor %}
    </div>

    <select class="fore-funny-variant-select" name="id" aria-label="Pack size">
      {% for variant in landing_product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant.id == selected_variant.id %}selected="selected"{% endif %}
        >
          {{ variant.title }}
        </option>
      {% endfor %}
    </select>

    <button
      type="submit"
      class="atc-btn"
      id="mainAtc"
      {% unless selected_variant.available %}disabled{% endunless %}
    >
      {% if selected_variant.available %}
        🛒 Add to Cart — {{ selected_variant.price | money }} AUD
      {% else %}
        Sold Out — {{ selected_variant.price | money }} AUD
      {% endif %}
    </button>
    {{ form | payment_button }}
  {% endform %}
{% else %}
  <p class="pack-label">Choose your pack</p>
  <div class="packs">
    <button type="button" class="pack-option" data-pack="10" onclick="selectPack(this)">
      <div class="pack-qty">× 10 tees</div>
      <div class="pack-price">$5.40</div>
      <div class="pack-per">$0.54 per tee</div>
    </button>
    <button type="button" class="pack-option selected" data-pack="50" onclick="selectPack(this)">
      <div class="pack-popular">⭐ Most Popular</div>
      <div class="pack-qty">× 50 tees</div>
      <div class="pack-price">$26.00</div>
      <div class="pack-per">$0.52 per tee</div>
    </button>
    <button type="button" class="pack-option" data-pack="100" onclick="selectPack(this)">
      <div class="pack-qty">× 100 tees</div>
      <div class="pack-price">$47.00</div>
      <div class="pack-per">$0.47 per tee — save 13%</div>
    </button>
    <button type="button" class="pack-option" data-pack="500" onclick="selectPack(this)">
      <div class="pack-qty">× 500 tees</div>
      <div class="pack-price">$200.00</div>
      <div class="pack-per">$0.40 per tee — best value</div>
    </button>
  </div>
  <button class="atc-btn" id="mainAtc" type="button" disabled>🛒 Add to Cart — $26.00 AUD</button>
  <button class="atc-secondary" type="button" disabled>⚡ Buy it now</button>
{% endif %}

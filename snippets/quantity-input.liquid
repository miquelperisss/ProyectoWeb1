{% doc %}
  Renders a cart quantity control.

  @param {line_item} item - The cart line item
  @param {number} line - The cart line number
{% enddoc %}

<quantity-input class="cart-quantity" data-cart-quantity>
  <button
    class="cart-quantity__button"
    type="button"
    name="minus"
    data-cart-quantity-minus
    aria-label="Decrease quantity for {{ item.product.title | escape }}"
    {% if item.quantity <= 1 %}disabled{% endif %}
  >
    <span aria-hidden="true">−</span>
  </button>
  <input
    class="cart-quantity__input"
    type="number"
    name="updates[]"
    value="{{ item.quantity }}"
    min="0"
    inputmode="numeric"
    data-cart-quantity-input
    data-line="{{ line }}"
    aria-label="Quantity for {{ item.product.title | escape }}"
  >
  <button
    class="cart-quantity__button"
    type="button"
    name="plus"
    data-cart-quantity-plus
    aria-label="Increase quantity for {{ item.product.title | escape }}"
  >
    <span aria-hidden="true">+</span>
  </button>
</quantity-input>

      "default": "#b9828d"
    },
    {
      "type": "color",
      "id": "accent_soft_color",
      "label": "Soft accent",
      "default": "#f5dfe3"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 12,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",

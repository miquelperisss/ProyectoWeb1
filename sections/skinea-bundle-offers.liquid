      "label": "Text",
      "default": "<p>Curated skincare technology bundles make it easy to choose the best ritual, save more and feel confident at checkout.</p>"
    },
    {
      "type": "text",
      "id": "default_button_label",
      "label": "Default button label",
      "default": "Add bundle to bag"
    },
    {
      "type": "text",
